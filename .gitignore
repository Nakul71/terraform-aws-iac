# ===================================
# Terraform
# ===================================

# Local .terraform directory (downloaded providers/modules)
**/.terraform/*

# Terraform state files — NEVER commit these (contain secrets!)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file (optionally commit this to pin provider versions)
# .terraform.lock.hcl

# Terraform plan output (binary, contains sensitive data)
*.tfplan

# ===================================
# AWS Credentials — CRITICAL
# ===================================
.aws/
credentials
*credentials*

# ===================================
# OS Generated Files
# ===================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===================================
# Editor
# ===================================
.vscode/
.idea/
*.swp
*.swo
*~

# ===================================
# Logs
# ===================================
*.log
logs/

# ===================================
# Sensitive Files
# ===================================
*.pem
*.key
id_rsa
id_ed25519
secrets.tf
secret.tfvars
